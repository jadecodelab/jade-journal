# Copy this file to .env and fill in your values

# App password — required to open the journal in the browser
APP_PASSWORD=your-password-here

# ── AI Provider ──────────────────────────────────────────────────────────────
# Choose "ollama" (free, local) or "openai" (paid, cloud)
AI_PROVIDER=ollama

# Ollama (free, runs locally — https://ollama.com/download)
# After installing Ollama, run: ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# OpenAI (optional — only needed if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Server port (default: 3001)
PORT=3001

# Database
DATABASE_URL="file:./dev.db"
