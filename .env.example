# Copy this file to .env and fill in your values

# App password — required to open the journal in the browser
APP_PASSWORD=your-password-here

# OpenAI — leave blank to use fallback AI responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Server port (default: 3001)
PORT=3001

# Database (auto-configured for SQLite — do not change unless using Docker)
DATABASE_URL="file:./dev.db"
